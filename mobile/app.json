{
  "expo": {
    "name": "ReservasApp",
    "slug": "reservasapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4a90e2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reservasapp.mobile"
    },
    "android": {
      "package": "com.reservasapp.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "reservasapp",
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "706b4e1f-74f8-4f99-b637-d11b37b1e0d2"
      }
    }
  }
}
